<Window x:Class="KatalogOkienkowy3K.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogOkienkowy3K"
        mc:Ignorable="d"
        Title="Katalog Okienkowy" Height="600" Width="800">
    <!-- nowy layout w oparciu o grid -->
    <Grid Margin="10">
        <!-- trzy wiersze, w tym środkowy o dynamicznym rozmiarze -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- kolumny - lewa na całą szerokość, prawa tyle ile musi -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <!-- tekst ze starego layoutu -->
        <TextBlock Grid.Row="0" Grid.Column="0" 
            Text="Katalog produktów"
            FontSize="24" 
            FontWeight="Bold" />
        <!-- nowy guzik -->
        <Button Grid.Row="0" Grid.Column="1" 
                Content="Odśwież" Margin="0 10"/>
        <!-- lista produktów - placeholder - rozciągnięta na dwie kolumny -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Tu pojawi się lista produktów"
                   FontSize="18"/>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nazwa produktu:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0 10"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cena:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0 10"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Kategoria:"
                       VerticalAlignment="Center"/>

            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0 10">
                <ComboBoxItem Content="Kategoria 1"/>
                <ComboBoxItem Content="Kategoria 2"/>
                <ComboBoxItem Content="Kategoria 3"/>
            </ComboBox>
            <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 10" 
                      Content="Produkt dostępny" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Grid.Row="4" Grid.Column="0" Margin="0 10"
                    Grid.ColumnSpan="2" 
                    Content="Dodaj" />
        </Grid>
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0"> 
                <TextBlock Text="Produktów: "
                            FontSize="14" FontWeight="Bold" />
                <TextBlock x:Name="EtykietaLiczbaProduktow" Text="0" FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBlock Text="Łączna wartość: "
                            FontSize="14" FontWeight="Bold" />
                <TextBlock x:Name="EtykietaWartoscMagazynu" 
                           Text="0" 
                           FontSize="14"/>
            </StackPanel>
            <Button Grid.Row="0" Grid.Column="2" Content="Usuń" Margin="0 0 5 0"/>
            <Button Grid.Row="0" Grid.Column="3" Content="Zamknij" Margin="5 0 0 0"/>
        </Grid>
    </Grid>
    <!-- stary layout
    <StackPanel Margin="20" x:Name="GlownyStackPanel">
        
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            
        </StackPanel>
        
        <Button HorizontalAlignment="Center" Padding="5">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Images/plus.png" Width="16" Height="16" Margin="0,0,5,0" />
                <TextBlock Text="Dodaj produkt" 
                       FontSize="16" 
                       FontWeight="Bold" />
            </StackPanel>
        </Button>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Row="0" Grid.Column="0" Content="Przycisk 1" Margin="5" />
            <Button Grid.Row="0" Grid.Column="1" Content="Przycisk 2" Margin="5" />
            <Button Grid.Row="1" Grid.Column="0" Content="Przycisk 3" Margin="5" />
            <Button Grid.Row="1" Grid.Column="1" Content="Przycisk 4" Margin="5" />
        </Grid>
    </StackPanel>
    stary layout -->
</Window>
