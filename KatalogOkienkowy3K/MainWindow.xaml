<Window x:Class="KatalogOkienkowy3K.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogOkienkowy3K"
        mc:Ignorable="d"
        Title="Katalog Okienkowy" Height="600" Width="800">
    <!-- nowy layout w oparciu o grid -->
    <Grid Margin="10">
        <!-- trzy wiersze, w tym środkowy o dynamicznym rozmiarze -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- kolumny - lewa na całą szerokość, prawa tyle ile musi -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <!-- tekst ze starego layoutu -->
        <TextBlock Grid.Row="0" Grid.Column="0" 
            Text="Katalog produktów"
            FontSize="24" 
            FontWeight="Bold" />
        <!-- nowy guzik -->
        <Button x:Name="PrzyciskOdswiez" Grid.Row="0" Grid.Column="1" 
                Content="Odśwież" Margin="0 10"/>
        <!-- lista produktów - placeholder -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Tu pojawi się lista produktów"
                   FontSize="18"/>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- nazwa produktu -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nazwa produktu:" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBoxNazwaProduktu" Grid.Column="1" Margin="0 10"/>
            <!-- cena produktu -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cena:" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBoxCenaProduktu" Grid.Row="1" Grid.Column="1" Margin="0 10"/>
            <!-- ilość produktu -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ilość:" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBoxIloscProduktu" Grid.Row="2" Grid.Column="1" Margin="0 10"/>
            <!-- kategoria produktu -->
            <TextBlock Grid.Row="3" Grid.Column="0" 
                       Text="Kategoria:" VerticalAlignment="Center"/>
            <ComboBox x:Name="ComboBoxKategoriaProduktu" Grid.Row="3" Grid.Column="1" Margin="0 10">
                <ComboBoxItem Content="Procesory"/>
                <ComboBoxItem Content="Karty graficzne"/>
                <ComboBoxItem Content="Płyty główne"/>
                <ComboBoxItem Content="Pamięci RAM"/>
                <ComboBoxItem Content="Dyski SSD"/> 
            </ComboBox>
            <!-- dostępność produktu -->
            <CheckBox x:Name="CheckBoxDostepnoscProduktu" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 10" 
                      Content="Produkt dostępny" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="PrzyciskDodaj" Grid.Row="5" Grid.Column="0" Margin="0 10"
                    Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Images/plus.png" Width="16" Height="16" Margin="0,0,5,0" />
                    <TextBlock Text="Dodaj produkt" />
                </StackPanel>
            </Button>

        </Grid>
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"> 
                <TextBlock Text="Produktów: "
                            FontSize="14" FontWeight="Bold" />
                <TextBlock x:Name="EtykietaLiczbaProduktow" Text="0" FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Łączna wartość: "
                            FontSize="14" FontWeight="Bold" />
                <TextBlock x:Name="EtykietaWartoscMagazynu" 
                           Text="0" 
                           FontSize="14"/>
            </StackPanel>
            <Button x:Name="PrzyciskUsun" Grid.Row="0" Grid.Column="2" Content="Usuń" Margin="0 0 5 0"/>
            <Button x:Name="PrzyciskZamknij" Grid.Row="0" Grid.Column="3" Content="Zamknij" Margin="5 0 0 0"/>
        </Grid>
    </Grid>
    <!-- stary layout
    <StackPanel Margin="20" x:Name="GlownyStackPanel">
        
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            
        </StackPanel>
        
        <Button HorizontalAlignment="Center" Padding="5">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Images/plus.png" Width="16" Height="16" Margin="0,0,5,0" />
                <TextBlock Text="Dodaj produkt" 
                       FontSize="16" 
                       FontWeight="Bold" />
            </StackPanel>
        </Button>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Row="0" Grid.Column="0" Content="Przycisk 1" Margin="5" />
            <Button Grid.Row="0" Grid.Column="1" Content="Przycisk 2" Margin="5" />
            <Button Grid.Row="1" Grid.Column="0" Content="Przycisk 3" Margin="5" />
            <Button Grid.Row="1" Grid.Column="1" Content="Przycisk 4" Margin="5" />
        </Grid>
    </StackPanel>
    stary layout -->
</Window>
